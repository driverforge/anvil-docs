# URL of the Anvil app, used by the docs API-key feature to call
# `/api/docs/projects` with credentials.
#
# Local dev (Caddy on *.driverforge.test): https://dev.driverforge.test
# Production: set as a build environment variable on the Cloudflare Pages
# project (infra/platform/docs-site-build.ts).
APP_URL=https://dev.driverforge.test

# GA4 via Google tag gateway. Leave empty in local dev — the
# /gt path only exists behind the Cloudflare proxy in production.
# Production sets it on the Pages project; previews leave it empty.
GA_MEASUREMENT_ID=
